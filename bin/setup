#!/usr/bin/env bash

set -euo pipefail

# Lightweight setup for the skills repo:
#   1. Record where your tasks-vault lives (the config the bundled
#      omt-scaffold-feature/bin/bootstrap-task reads).
#   2. Create that vault directory.
#   3. Optionally symlink the skills into ~/.claude/skills for Claude Code.
#
# Templates are NOT copied anywhere — each skill bundles its own templates
# (see omt-scaffold-feature/templates/), so there is a single source of truth.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILLS_REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
CONFIG_FILE="${OMT_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/omt/config}"
DEFAULT_VAULT="$HOME/omt-tasks"

printf '=== OMT Skills Setup ===\n\n'

# --- 1. Tasks vault path ---

EXISTING_VAULT=""
if [[ -f "$CONFIG_FILE" ]]; then
  EXISTING_VAULT="$(sed -n 's/^[[:space:]]*vault[[:space:]]*=[[:space:]]*//p' "$CONFIG_FILE" | head -n1)"
fi

DEFAULT_ANSWER="${EXISTING_VAULT:-$DEFAULT_VAULT}"
printf 'Tasks vault path [%s]: ' "$DEFAULT_ANSWER" >&2
read -r answer
VAULT_DIR="${answer:-$DEFAULT_ANSWER}"
VAULT_DIR="${VAULT_DIR/#\~/$HOME}"

mkdir -p "$(dirname "$CONFIG_FILE")"
printf 'vault=%s\n' "$VAULT_DIR" > "$CONFIG_FILE"
printf 'Config written: %s → vault=%s\n' "$CONFIG_FILE" "$VAULT_DIR"

# --- 2. Create vault directory ---

if [[ ! -d "$VAULT_DIR" ]]; then
  mkdir -p "$VAULT_DIR"
  printf 'Created vault: %s\n' "$VAULT_DIR"
else
  printf 'Vault exists:  %s\n' "$VAULT_DIR"
fi

# --- 3. Claude Code skill symlinks (optional) ---

printf '\n--- Claude Code Integration ---\n'

CLAUDE_SKILLS_DIR="$HOME/.claude/skills"

printf 'Symlink skills to %s? [Y/n]: ' "$CLAUDE_SKILLS_DIR" >&2
read -r answer
answer="${answer:-Y}"

if [[ "$(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]')" == "y" || "$(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]')" == "yes" ]]; then
  mkdir -p "$CLAUDE_SKILLS_DIR"

  LINKED=0
  SKIPPED=0
  for skill_dir in "$SKILLS_REPO_DIR"/*/; do
    skill_name="$(basename "$skill_dir")"

    # Skip non-skill directories
    if [[ ! -f "$skill_dir/SKILL.md" ]]; then
      continue
    fi

    target="$CLAUDE_SKILLS_DIR/$skill_name"
    if [[ -L "$target" ]]; then
      existing="$(readlink "$target")"
      if [[ "$existing" == "$skill_dir" || "$existing" == "${skill_dir%/}" ]]; then
        SKIPPED=$((SKIPPED + 1))
        continue
      fi
      rm "$target"
    elif [[ -e "$target" ]]; then
      printf '  SKIP %s (exists, not a symlink)\n' "$skill_name"
      SKIPPED=$((SKIPPED + 1))
      continue
    fi

    ln -s "${skill_dir%/}" "$target"
    LINKED=$((LINKED + 1))
  done

  printf '  Linked: %d skills, Skipped: %d (already linked)\n' "$LINKED" "$SKIPPED"
else
  printf 'Skipped Claude Code integration.\n'
  printf 'For other AI agents, point them at SKILL.md files in: %s\n' "$SKILLS_REPO_DIR"
fi

# --- Done ---

printf '\n=== Setup Complete ===\n\n'
printf 'Tasks vault:  %s\n' "$VAULT_DIR"
printf 'Skills repo:  %s\n' "$SKILLS_REPO_DIR"
printf 'Config:       %s\n' "$CONFIG_FILE"
printf '\nNext steps:\n'
printf '  1. In your project repo, run: /omt-scaffold-feature\n'
printf '  2. Or directly: %s/omt-scaffold-feature/bin/bootstrap-task --name "my feature"\n' "$SKILLS_REPO_DIR"
printf '\nFor non-Claude agents, use the SKILL.md files as workflow instructions.\n'
